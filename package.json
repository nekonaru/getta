{
  "name": "getta",
  "version": "0.1.0",
  "description": "Getta fetches media and files from across the web into your own folders. Free, open source, no account, no terminal.",
  "type": "module",
  "license": "MIT",
  "author": "Nicolas Dwi Dharma (https://github.com/nekonaru)",
  "repository": {
    "type": "git",
    "url": "https://github.com/nekonaru/getta.git"
  },
  "homepage": "https://github.com/nekonaru/getta",
  "scripts": {
    "dev": "vite dev --port 1420 --strictPort",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.9.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
