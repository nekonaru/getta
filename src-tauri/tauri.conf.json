{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Getta",
  "version": "0.7.0",
  "identifier": "com.getta.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "getta"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "Getta",
        "width": 1160,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#f4f1ea"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc:; img-src 'self' asset: data: blob: https:; media-src 'self' asset: blob: https:; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/getta/**",
            "$DOWNLOAD/**",
            "$TEMP/**"
          ],
          "deny": [
            "**/.ssh/**",
            "**/.aws/**",
            "**/.git/**"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nicolas Dwi Dharma",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "appimage": {},
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {}
    }
  }
}







